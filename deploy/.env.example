# Public URL of the bridge (your Cloudflare hostname). Goes into pairing QR codes.
BRIDGE_PUBLIC_URL=https://budget-api.example.com

# How the bridge logs in to Actual: the server password, or for OIDC / multi-user
# servers a session token for a user that has access to the household budget(s).
ACTUAL_PASSWORD=change-me
# ACTUAL_SESSION_TOKEN=

# Only for end-to-end encrypted budgets: <syncId>=<password>,<syncId>=<password>
# The sync ID is in Actual under Settings > Advanced settings. If it's missing, the app
# shows the exact line to add when you open that budget.
# ACTUAL_BUDGET_PASSWORDS=

# Cloudflare Access service token for the bridge hostname (handed to phones at pairing).
# CF_ACCESS_CLIENT_ID=xxxxxxxx.access
# CF_ACCESS_CLIENT_SECRET=

CLOUDFLARE_TUNNEL_TOKEN=

# LOG_LEVEL=info
