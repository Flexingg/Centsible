# Public URL of the bridge (your Cloudflare hostname). Goes into pairing QR codes.
BRIDGE_PUBLIC_URL=https://budget-api.example.com

# First-time setup happens in the app: "Set up a new bridge", then the setup code the
# bridge prints on start (docker compose logs bridge). Or pick the code yourself here:
# BRIDGE_SETUP_CODE=my-setup-code

# How the bridge signs in to Actual. Optional: leave both unset and the app asks for the
# Actual password during setup (or sets it, on a brand-new Actual server) and the bridge
# keeps it in bridge-data/. For OpenID servers, a session token for a user that can
# open the household budget(s).
# ACTUAL_PASSWORD=
# ACTUAL_SESSION_TOKEN=

# Only for end-to-end encrypted budgets: <syncId>=<password>,<syncId>=<password>
# The sync ID is in Actual under Settings > Advanced settings. If it's missing, the app
# shows the exact line to add when you open that budget.
# ACTUAL_BUDGET_PASSWORDS=

# Cloudflare Access service token for the bridge hostname (handed to phones at pairing).
# CF_ACCESS_CLIENT_ID=xxxxxxxx.access
# CF_ACCESS_CLIENT_SECRET=

CLOUDFLARE_TUNNEL_TOKEN=

# LOG_LEVEL=info
